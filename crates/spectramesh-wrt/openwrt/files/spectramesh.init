#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1
PROG=/usr/sbin/spectrameshd
# Mesh keys are copied here, in RAM, readable only by root.
KEY_FILE=/var/run/spectramesh/mesh.key

add_hue() {
	local cfg="$1" device kind bitrate freq mtu spec

	config_get device "$cfg" device
	[ -n "$device" ] || return 0
	config_get kind "$cfg" kind ethernet
	config_get bitrate "$cfg" bitrate
	config_get freq "$cfg" freq
	config_get mtu "$cfg" mtu

	spec="$device,kind=$kind"
	[ -n "$bitrate" ] && spec="$spec,bitrate=$bitrate"
	[ -n "$freq" ] && spec="$spec,freq=$freq"
	[ -n "$mtu" ] && spec="$spec,mtu=$mtu"
	procd_append_param command --hue "$spec"
}

write_key() {
	echo "$1" >>"$KEY_FILE"
}

start_service() {
	local enabled identity

	config_load spectramesh
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	mkdir -p "${KEY_FILE%/*}"
	(umask 077 && : >"$KEY_FILE")
	config_list_foreach main mesh_key write_key
	if [ ! -s "$KEY_FILE" ]; then
		echo "spectramesh: no mesh_key set in /etc/config/spectramesh" >&2
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" --mesh-key-file "$KEY_FILE"
	config_get identity main identity /etc/spectramesh/node.key
	procd_append_param command --identity "$identity"
	config_get tun main tun
	[ -n "$tun" ] && procd_append_param command --tun "$tun"
	config_get ipv6_prefix main ipv6_prefix
	[ -n "$ipv6_prefix" ] && procd_append_param command --ipv6-prefix "$ipv6_prefix"
	config_foreach add_hue hue
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger spectramesh
}
