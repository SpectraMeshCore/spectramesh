config spectramesh 'main'
	# Off until hues are configured below.
	option enabled '0'
	# Defaults to the last four bytes of the first device's MAC address.
	#option node_id 'a1b2c3d4'

# One 'hue' section per network device SpectraMesh routes over. 'device' is a
# Linux device name (see 'ip link'), not an OpenWRT network name.
#
# kind:    ethernet (including fiber), wifi or halow. Default: ethernet.
# bitrate: bits per second, with an optional k, M or G suffix.
#          Default 1G for ethernet; required for wifi and halow.
# freq:    radio channel frequency in MHz.
# mtu:     largest SpectraMesh frame. Default: the device's MTU less 2.

#config hue
#	option device 'eth1'
#	option kind 'ethernet'

#config hue
#	option device 'phy1-mesh0'
#	option kind 'wifi'
#	option freq '5805'
#	option bitrate '100M'
