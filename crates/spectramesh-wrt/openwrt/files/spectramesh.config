config spectramesh 'main'
	# Off until a mesh key and hues are configured below.
	option enabled '0'
	# Every node in the mesh needs the same key. Make one with:
	#   spectrameshd --generate-mesh-key
	# While changing keys, list the new key first and keep the old one until
	# every node has the new one.
	#list mesh_key 'smk1-...'
	# This node's secret key, created on first start. Back it up to keep the
	# node's ID when reinstalling.
	#option identity '/etc/spectramesh/node.key'
	# Carry IPv6 over the mesh through this TUN device. Each node's address
	# is the mesh's /64 followed by its node ID; see 'spectrameshd --node-info'.
	#option tun 'smesh0'
	# The mesh's /64. Defaults to one derived from the first mesh key, which
	# changes when the key does; set it to keep addresses stable.
	#option ipv6_prefix 'fd12:3456:789a::'
	# Channels to join, for group messages across the mesh. Make a key with:
	#   spectrameshd --generate-channel-key
	#list channel_key 'smc1-...'

# One 'hue' section per network device SpectraMesh routes over. 'device' is a
# Linux device name (see 'ip link'), not an OpenWRT network name.
#
# kind:    ethernet (including fiber), wifi or halow. Default: ethernet.
# bitrate: bits per second, with an optional k, M or G suffix.
#          Default 1G for ethernet; required for wifi and halow.
# freq:    radio channel frequency in MHz.
# mtu:     largest SpectraMesh frame. Default: the device's MTU less 2.

#config hue
#	option device 'eth1'
#	option kind 'ethernet'

#config hue
#	option device 'phy1-mesh0'
#	option kind 'wifi'
#	option freq '5805'
#	option bitrate '100M'
